{
  "name": "desktop-cat",
  "version": "1.0.0",
  "description": "Pixel cats that live on the bottom of your screen: they walk, groom, nap, roll over and chase yarn.",
  "main": "main.js",
  "author": "chaivetta",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:steam": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.chaivetta.pawsport",
    "productName": "Pawsport",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Pawsport uses the microphone only when you record a meow for your cats."
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "extraFiles": [
      {
        "from": "steam_appid.txt",
        "to": "steam_appid.txt",
        "filter": [
          "steam_appid.txt"
        ]
      }
    ]
  }
}
